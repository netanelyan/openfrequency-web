{
  "name": "openfrequency-web",
  "private": true,
  "description": "OpenFrequency's public website: static pages built from site.config.json",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node build.mjs",
    "draft": "node build.mjs --draft",
    "dev": "node build.mjs --draft --banner && node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "shots": "node scripts/shots.mjs",
    "og": "node scripts/og.mjs",
    "leads": "node server/lead.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "support": "node scripts/support-export.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "playwright-core": "^1.56.0"
  }
}
