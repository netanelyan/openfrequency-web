# /etc/openfrequency-web/lead.env, mode 600. The lead endpoint's secrets; never in the repo.

# https://<domain>, the same as "domain" in site.config.json. Posts from any other origin are refused.
SITE_ORIGIN=https://openfrequency.co.il

# Each lead goes from the business number to your own WhatsApp, through Twilio (README, "Leads"). Leave the account
# empty to only save leads. Numbers in any spelling: 0552536259, +972 55-253-6259 or 972552536259.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
LEAD_WA_FROM=0552536259
LEAD_WA_TO=
# The approved WhatsApp template (HX...), its {{1}} the lead. Empty: plain text, delivered only within 24 hours of your
# last message to the business number.
LEAD_WA_CONTENT_SID=

# Toran's intake on this machine: each Toran demo is handed to it as {url, code}, and Toran counts it once the person
# writes to the demo number with that code. The token is OF_INTERNAL_TOKEN from Toran's private/.env (the same value
# accounts has). Leave both empty to skip it.
TORAN_INTAKE_URL=http://127.0.0.1:4710/internal/lead
OF_INTERNAL_TOKEN=

# Teder's intake on this machine: each Teder demo is handed to it as {url, whatsapp}. Leave empty to skip it.
TEDER_INTAKE_URL=http://127.0.0.1:4700/internal/lead

# Toran's demo WhatsApp number, digits only with the country code (972...), the number Toran's demo answers on.
# A Toran demo's form answers with a wa.me link to it, with a message holding the request's code. Without it the form
# shows the code alone, and nobody can send it, so set it before the form is public.
TORAN_DEMO_WA=
