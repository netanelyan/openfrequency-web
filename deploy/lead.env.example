# /etc/openfrequency-web/lead.env, mode 600. The lead endpoint's secrets; never in the repo.

# https://<domain>, the same as "domain" in site.config.json. Posts from any other origin are refused.
SITE_ORIGIN=https://example.co.il

# The bot that pings you about each lead (README, "Leads"). Leave both empty to only save leads.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Toran's intake on this machine: each demo lead is handed to it, and the store shows up in Toran's dashboard. The
# token is OF_INTERNAL_TOKEN from Toran's private/.env (the same value accounts has). Leave both empty to skip it.
TORAN_INTAKE_URL=http://127.0.0.1:4710/internal/lead
OF_INTERNAL_TOKEN=

# Toran's demo number, international digits (9725XXXXXXXX): the form's button opens WhatsApp to it with the request's
# code written. Until there is one, a demo request can't be confirmed and the form answers as down.
DEMO_WA_NUMBER=
